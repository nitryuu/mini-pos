    "bullmq": "^5.78.0",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.12.23",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.1",
    "@testcontainers/redis": "^12.0.1",
    "@types/bun": "^1.3.14",
    "@vitest/coverage-v8": "4.1.8",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.0.1",
    "tsx": "^4.22.4",
    "vitest": "^4.1.8"
